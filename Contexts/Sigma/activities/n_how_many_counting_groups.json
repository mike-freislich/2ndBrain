{
  "specVersion": "1.1-DRAFT",
  "locale": "en-ZA",

  "meta": {
    "identifier": "n_how_many_counting_groups",
    "title": "How many counting groups",
    "subject": "Numeracy",
    "subconstructs": ["N1.1", "N1.2"],
    "skillsMapping": ["N1.1.1-F", "N1.2.1-G1"],
    "activityFamily": "Interactive - Drag",
    "activityType": "Drag and drop into a box (individual)",
    "layoutTemplate": null,
    "description": "Counting 1–10 items into an object according to audio instructions. Very early level game, kept simple (e.g. no done button).",
    "senAffordances": [],
    "suggestedGlobalParams": {
      "numberOfRounds": 4,
      "showDemo": true,
      "showOutro": true
    }
  },

  "novelParams": {
    "totalItemsOnScreen": {
      "type": "integerRange",
      "logic": "Equal to (target category items + 1) at minimum.",
      "levels": {
        "L1": { "min": 3, "max": 10 },
        "L2": { "min": 4, "max": 20 },
        "L3": { "min": 5, "max": 20 }
      }
    },
    "numberOfItemCategories": {
      "type": "integer",
      "logic": "Items from the target category must never have the same count as any other category on screen.",
      "levels": {
        "L1": 2,
        "L2": 3,
        "L3": 4
      }
    },
    "categoryItemMax": {
      "type": "integer",
      "logic": "Maximum count for any single category on screen.",
      "levels": {
        "L1": 10,
        "L2": 10,
        "L3": 10
      }
    },
    "itemSizes": {
      "type": "string",
      "enum": ["consistent", "varied"],
      "levels": {
        "L1": "consistent",
        "L2": "varied",
        "L3": "varied"
      }
    },
    "feedbackTiming": {
      "type": "string",
      "enum": ["instant", "delayed"],
      "levels": {
        "L1": "instant",
        "L2": "instant",
        "L3": "instant"
      }
    }
  },

  "actionSequence": {
    "core": [
      {
        "phase": "intro",
        "step": 1,
        "required": false,
        "actions": ["character_enters"],
        "audio": { "$ref": "#/strings/intro_prompt" },
        "sfx": null
      },
      {
        "phase": "demo",
        "step": 1,
        "required": false,
        "actions": ["empty_container_appears", "target_number_above_container", "items_scattered_to_side", "teacher_enters"],
        "audio": { "$ref": "#/strings/demo_pick_right_items" },
        "sfx": null
      },
      {
        "phase": "demo",
        "step": 2,
        "required": false,
        "actions": ["target_number_emphasised"],
        "audio": { "$ref": "#/strings/demo_we_need_n_items" },
        "sfx": null
      },
      {
        "phase": "demo",
        "step": 3,
        "required": false,
        "actions": ["pointer_picks_item", "pointer_drags_to_container"],
        "audio": { "$ref": "#/strings/demo_drag_instruction" },
        "sfx": null
      },
      {
        "phase": "demo",
        "step": 4,
        "required": false,
        "actions": ["item_drops_into_container", "container_fill_animation"],
        "audio": null,
        "sfx": "scenario_drop_sfx"
      },
      {
        "phase": "demo",
        "step": 5,
        "required": false,
        "condition": "target_reached",
        "actions": ["target_reached_indicator"],
        "audio": { "$ref": "#/strings/demo_confirm_then_your_turn" },
        "sfx": null
      },
      {
        "phase": "main",
        "step": 1,
        "required": true,
        "repeat": "numberOfRounds",
        "actions": ["container_resets", "new_items_appear", "new_target_number_displayed"],
        "audio": { "$ref": "#/strings/main_we_need_n_items" },
        "sfx": null
      },
      {
        "phase": "main",
        "step": 2,
        "required": true,
        "actions": ["learner_drags_items_to_container", "drop_animation_per_item"],
        "audio": null,
        "sfx": "scenario_drop_sfx"
      },
      {
        "phase": "main",
        "step": 3,
        "required": true,
        "condition": "target_reached",
        "actions": ["target_reached_indicator"],
        "audio": { "$ref": "#/strings/main_confirm_count" },
        "sfx": null
      },
      {
        "phase": "main",
        "step": 4,
        "required": false,
        "condition": "all_items_used",
        "actions": ["container_top_view", "full_container_reveal"],
        "audio": { "$ref": "#/strings/main_all_done" },
        "sfx": null
      },
      {
        "phase": "outro",
        "step": 1,
        "required": false,
        "actions": ["random_outro_sequence"],
        "audio": null,
        "sfx": "fanfare"
      }
    ],
    "contextualised": [
      {
        "settingKey": "soup_pot",
        "steps": [
          {
            "phase": "intro",
            "step": 1,
            "required": false,
            "sceneDirection": { "$ref": "#/strings/cx_intro_scene_1" },
            "audio": [
              { "$ref": "#/strings/cx_intro_oops" },
              { "$ref": "#/strings/cx_intro_not_worried" }
            ],
            "sfx": null
          },
          {
            "phase": "intro",
            "step": 2,
            "required": false,
            "sceneDirection": { "$ref": "#/strings/cx_intro_scene_2" },
            "audio": { "$ref": "#/strings/cx_intro_help_make_dinner" },
            "sfx": null
          },
          {
            "phase": "demo",
            "step": 4,
            "required": false,
            "actions": ["splash_animation", "steam_appears", "steam_fades"],
            "audio": null,
            "sfx": "splash"
          }
        ]
      }
    ]
  },

  "strings": {
    "_comment": "All localisable strings. Placeholders use {param} syntax resolved at runtime.",

    "intro_prompt":               "Can you help {object_character} count?",

    "demo_pick_right_items":      "We must pick the right items.",
    "demo_we_need_n_items":       "We need {num_items} {items}.",
    "demo_drag_instruction":      "Drag the {items} into the {object}, like this.",
    "demo_confirm_then_your_turn":"{num_items} {items}. Now it's your turn.",

    "main_we_need_n_items":       "We need {num_items} {items}.",
    "main_confirm_count":         "{num_items} {items}.",
    "main_all_done":              "It is all done. Good job!",

    "cx_intro_scene_1":           "Scene: An empty kitchen indicating dinner is coming up. {object_character} appears looking surprised, then poses with hands on hips, supremely confident.",
    "cx_intro_oops":              "{object_character} forgot! Mom is working tonight! (Oops!)",
    "cx_intro_not_worried":       "{object_character} isn't worried.",
    "cx_intro_scene_2":           "{object_character} pulls on a chef hat and picks up a cooking tool, ready to go.",
    "cx_intro_help_make_dinner":  "{object_character} is going to make dinner for when Mom gets home! Can you help?"
  },

  "characters": {
    "object_character": {
      "name": "Helper",
      "role": "protagonist",
      "description": "Generic helper character — replace with named character per setting"
    }
  },


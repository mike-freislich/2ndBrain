{
  "specVersion": "1.0-DRAFT",
  "locale": "en-ZA",

  "meta": {
    "identifier": "n_select_shelf",
    "title": "Select Shelf with X Items",
    "subject": "Numeracy",
    "subconstructs": ["N1.1", "N1.2"],
    "skillsMapping": ["N1.1.1-F", "N1.2.1-F"],
    "activityFamily": "Interactive - Tap",
    "activityType": "Tap to select answer with audio clue",
    "layoutTemplate": "layout_1",
    "description": "Choose the correct number of items to match an audio clue",
    "senAffordances": [
      "Consider the colour contrast and how visible items will be for those with colour blindness or other sight impairments"
    ]
  },

  "novelParams": {
    "numberOfItemsPerShelf": {
      "type": "integerRange",
      "logic": "No shelves must have the same number of items.",
      "levels": {
        "L1": { "min": 1, "max": 5 },
        "L2": { "min": 1, "max": 5 },
        "L3": { "min": 1, "max": 10 },
        "L4": { "min": 1, "max": 10 }
      }
    },
    "numberOfShelves": {
      "type": "integer",
      "levels": {
        "L1": 2,
        "L2": 3,
        "L3": 3,
        "L4": 3
      }
    },
    "itemHomogeneity": {
      "type": "string",
      "enum": ["same", "mixed"],
      "levels": {
        "L1": "same",
        "L2": "same",
        "L3": "same",
        "L4": "mixed"
      }
    },
    "feedbackTiming": {
      "type": "string",
      "enum": ["instant", "delayed"],
      "logic": "If shelf clicked is incorrect, shelf outlines in red with incorrect effect and SFX with audio.",
      "levels": {
        "L1": "instant",
        "L2": "instant",
        "L3": "delayed",
        "L4": "delayed"
      }
    }
  },

  "actionSequence": {
    "core": [
      {
        "phase": "intro",
        "step": 1,
        "required": false,
        "actions": ["character_enters"],
        "audio": { "$ref": "#/strings/intro_prompt" },
        "sfx": null
      },
      {
        "phase": "demo",
        "step": 1,
        "required": false,
        "actions": ["shelves_appear", "items_randomised", "target_number_displayed"],
        "audio": { "$ref": "#/strings/demo_tap_instruction" },
        "sfx": null
      },
      {
        "phase": "demo",
        "step": 2,
        "required": false,
        "actions": ["pointer_counts_shelf_1", "pointer_counts_shelf_2", "pointer_clicks_correct"],
        "audio": [
          { "$ref": "#/strings/demo_count_shelf_1" },
          { "$ref": "#/strings/demo_count_shelf_2" },
          { "$ref": "#/strings/demo_click_instruction" }
        ],
        "sfx": "pop_appear"
      },
      {
        "phase": "demo",
        "step": 3,
        "required": false,
        "actions": ["colour_block_appears", "number_appears_right"],
        "audio": { "$ref": "#/strings/demo_confirm_count" },
        "sfx": null
      },
      {
        "phase": "main",
        "step": 1,
        "required": true,
        "repeat": "numberOfRounds",
        "actions": ["shelves_appear_randomised", "audio_target_prompt"],
        "audio": { "$ref": "#/strings/main_choose_shelf" },
        "sfx": "pop_appear"
      },
      {
        "phase": "main",
        "step": 2,
        "required": true,
        "condition": "correct_selection",
        "actions": ["colour_block_appears", "number_confirmed"],
        "audio": { "$ref": "#/strings/main_confirm_count" },
        "sfx": "swoosh"
      },
      {
        "phase": "main",
        "step": 3,
        "required": true,
        "variant": "three_shelves",
        "condition": "level >= L2",
        "actions": ["three_shelf_layout"],
        "audio": null,
        "sfx": null
      },
      {
        "phase": "main",
        "step": 4,
        "required": true,
        "variant": "mixed_items_with_check",
        "condition": "level >= L3",
        "actions": ["mixed_items_layout", "check_button_displayed"],
        "audio": { "$ref": "#/strings/main_mixed_check_instruction" },
        "sfx": null
      },
      {
        "phase": "main",
        "step": 5,
        "required": true,
        "variant": "incorrect_feedback",
        "condition": "incorrect_selection",
        "actions": ["shelf_outlines_red", "incorrect_effect"],
        "audio": { "$ref": "#/strings/feedback_incorrect" },
        "sfx": "troubleshoot_fail"
      },
      {
        "phase": "outro",
        "step": 1,
        "required": false,
        "actions": ["character_appears"],
        "audio": { "$ref": "#/strings/outro_celebration" },
        "sfx": "fanfare"
      }
    ],

    "contextualised": {
      "settingKey": "spaza_shop",
      "steps": [
        {
          "phase": "intro",
          "step": 1,
          "required": false,
          "sceneDirection": { "$ref": "#/strings/cx_intro_scene_1" },
          "audio": [
            { "$ref": "#/strings/cx_intro_narrator_1" },
            { "$ref": "#/strings/cx_intro_character_1" }
          ],
          "sfx": "ambient_town_music"
        },
        {
          "phase": "intro",
          "step": 2,
          "required": false,
          "sceneDirection": { "$ref": "#/strings/cx_intro_scene_2" },
          "audio": [
            { "$ref": "#/strings/cx_intro_ready" },
            { "$ref": "#/strings/cx_intro_customer_needs" }
          ],
          "sfx": null
        },
        {
          "phase": "intro",
          "step": 3,
          "required": false,
          "sceneDirection": { "$ref": "#/strings/cx_intro_scene_3" },
          "audio": { "$ref": "#/strings/cx_intro_help_prompt" },
          "sfx": null
        },
        {
          "phase": "demo",
          "step": 1,
          "required": false,
          "actions": ["shelves_appear", "items_randomised", "target_number_displayed"],
          "audio": { "$ref": "#/strings/demo_tap_instruction" },
          "sfx": null
        },
        {
          "phase": "demo",
          "step": 2,
          "required": false,
          "actions": ["pointer_counts_shelf_1", "pointer_counts_shelf_2", "pointer_clicks_correct"],
          "audio": [
            { "$ref": "#/strings/demo_count_shelf_1" },
            { "$ref": "#/strings/demo_count_shelf_2" },
            { "$ref": "#/strings/demo_click_instruction" }
          ],
          "sfx": "pop_appear"
        },
        {
          "phase": "demo",
          "step": 3,
          "required": false,
          "actions": ["colour_block_appears", "number_appears_right"],
          "audio": { "$ref": "#/strings/demo_confirm_count" },
          "sfx": null
        },
        {
          "phase": "demo",
          "step": 4,
          "required": false,
          "sceneDirection": { "$ref": "#/strings/cx_demo_customer_thanks" },
          "audio": { "$ref": "#/strings/cx_thank_customer" },
          "sfx": null
        },
        {
          "phase": "demo",
          "step": 5,
          "required": false,
          "sceneDirection": { "$ref": "#/strings/cx_demo_next_customer" },
          "audio": { "$ref": "#/strings/cx_next_customer_needs" },
          "sfx": null
        },
        {
          "phase": "main",
          "step": 1,
          "required": true,
          "repeat": "numberOfRounds",
          "actions": ["shelves_appear_randomised"],
          "audio": { "$ref": "#/strings/main_choose_shelf" },
          "sfx": "pop_appear"
        },
        {
          "phase": "main",
          "step": 2,
          "required": true,
          "condition": "correct_selection",
          "actions": ["colour_block_appears", "number_confirmed"],
          "audio": { "$ref": "#/strings/main_confirm_count" },
          "sfx": "swoosh"
        },
        {
          "phase": "main",
          "step": 3,
          "required": true,
          "condition": "correct_selection",
          "sceneDirection": { "$ref": "#/strings/cx_main_customer_thanks" },
          "audio": { "$ref": "#/strings/cx_thank_customer" },
          "sfx": null
        },
        {
          "phase": "outro",
          "step": 1,
          "required": false,
          "actions": ["character_appears"],
          "audio": { "$ref": "#/strings/outro_celebration" },
          "sfx": "fanfare"
        }
      ]
    }
  },

  "strings": {
    "_comment": "All localisable strings. Placeholders use {param} syntax resolved at runtime.",

    "intro_prompt":                 "Can you help {object_character} choose the {object} with the correct amount of items?",

    "demo_tap_instruction":         "Tap the {object} with {num_items} {items}.",
    "demo_count_shelf_1":           "{num_items_shelf_1}",
    "demo_count_shelf_2":           "{num_items_shelf_2}",
    "demo_click_instruction":       "Click on the {object} with {num_items} {items}.",
